# Cloudflare Pages local development environment variables
# Copy this file to .dev.vars for local testing: cp .dev.vars.example .dev.vars
# (Note: .dev.vars is strictly excluded by .gitignore and will NEVER be committed)

FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
OWNER_UID=your_firebase_owner_uid
OWNER_EMAIL=owner@example.com
OWNER_HANDLE=your_handle
PUBLIC_URL=https://ngl.example.com

# Optional dual-forward & Telegram delivery secrets:
NGL_UPSTREAM_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
